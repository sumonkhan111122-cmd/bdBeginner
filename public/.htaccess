<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/weadown/* requests to native cPanel PHP API
  RewriteRule ^api/weadown/(.*)$ api/weadown/index.php?endpoint=$1 [QSA,L]

  # Route Facebook Catalog Feed aliases
  RewriteRule ^facebook-catalog\.xml$ api/catalog/facebook-feed.php [L,QSA]
  RewriteRule ^facebook-catalog\.csv$ api/catalog/facebook-feed.php?format=csv [L,QSA]
  RewriteRule ^api/catalog/facebook-catalog\.xml$ api/catalog/facebook-feed.php [L,QSA]

  # Route sitemap.xml to dynamic real-time PHP generator
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L,QSA]

  # Social Crawlers / Facebook Scraper: dynamic Open Graph metadata for product pages
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot) [NC]
  RewriteRule ^products/([a-zA-Z0-9_-]+)/?$ api/og.php?slug=$1 [L,QSA]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other SPA requests to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Static Asset Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
